# tests read gatto's own source and search it for the newline it was written with
# git must not translate it or a fresh checkout fails on a pattern that cannot match
*.cs text eol=lf

# shipped sources are embedded and written to the user's home byte for byte
# git must not translate line endings here or the published hashes stop matching
Gatto/Shipped/** -text

# the config schema is written into the user's home byte for byte on every launch
# git must not translate it or the written bytes depend on the building machine
Gatto/Core/Home/gatto.schema.json -text

# a golden is a byte-for-byte record of a rendered screen
# git must not translate it or a fresh checkout measures a carriage return as a visible cell
Gatto.Tests/Setup/Tui/Goldens/** -text

# a fixture is a capture and the manifest hashes its bytes
# git must not translate it or the hash depends on the checkout machine
Gatto.Tests/Fixtures/** -text
